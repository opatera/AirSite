[Unit]
Description=AirSite Python web application
After=network.target

[Service]
Type=simple
User=airowen
Group=airowen
WorkingDirectory=/home/airowen/git/AirSite
ExecStart=/usr/bin/python3 /home/airowen/git/AirSite/server.py --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
